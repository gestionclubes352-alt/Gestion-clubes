# ╔═══════════════════════════════════════════════════════════════╗
# ║  Gestión Clubes — Variables de entorno (Supabase + Vercel)   ║
# ║                                                                ║
# ║  1. Copia este archivo:  cp .env.example .env                 ║
# ║  2. Rellena los valores desde Supabase → Project Settings → API║
# ║  3. NUNCA subas .env a Git (ya está en .gitignore)             ║
# ╚═══════════════════════════════════════════════════════════════╝

# URL del proyecto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://kvshetedmhmtxodnxcne.supabase.co

# anon / public key (Project Settings → API → anon public)
# Esta key SÍ puede ir en el frontend: está protegida por las políticas RLS.
# NUNCA uses aquí la service_role key.
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Google Gemini AI (si mantienes el asistente IA del proyecto original)
GEMINI_API_KEY=tu_gemini_api_key
